## Dev sentinel (Norminette file + uncomment & compile all in triggered directory)
clear && inotifywait --include '\.c$' -mre modify . | while read -r DIR EVENT FILE; do clear && cat "$DIR/*.c" | perl -0777 -pe 's|/\*(\s*(?:(?!\*/).)*?int\smain.*?)\*/|$1|gs' | cc -Wall -Wextra -Werror -x c - && norminete "$DIR/$FILE"; done

## Instant review (Norminette & uncomment & compile all files in all directories)
clear && tree && read -p "Press Enter to continue..." && clear && find -mindepth 1 -type d | while read -r DIR; do norminette "$DIR" && read -p "Press Enter to continue..." && clear && cat "$DIR/*.c" | perl -0777 -pe 's|/\*(\s*(?:(?!\*/).)*?int\smain.*?)\*/|$1|gs' | cc -Wall -Wextra -Werror -x c - -o "$DIR/a.out"; done



